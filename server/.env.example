CHANNEL_B_READ_KEY=L4M5T06RXQ9MR1AS
# Masukkan Write API Key Channel B Anda di bawah ini agar dashboard dapat mengirim perintah
CHANNEL_B_WRITE_KEY=YOUR_CHANNEL_B_WRITE_KEY_HERE

